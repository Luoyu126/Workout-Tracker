{
  "name": "@workout-tracker/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "npm run start:local",
    "start:local": "node --env-file=../../.env.local ../../node_modules/expo/bin/cli start",
    "start:remote": "node --env-file=../../.env.remote ../../node_modules/expo/bin/cli start",
    "android": "node --env-file=../../.env.local ../../node_modules/expo/bin/cli start --android",
    "android:remote": "node --env-file=../../.env.remote ../../node_modules/expo/bin/cli start --android",
    "ios": "node --env-file=../../.env.local ../../node_modules/expo/bin/cli start --ios",
    "ios:remote": "node --env-file=../../.env.remote ../../node_modules/expo/bin/cli start --ios",
    "release-env:check": "node scripts/check-release-env.mjs",
    "test": "vitest run",
    "smoke": "vitest run tests/mobile-smoke.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.48.0",
    "@tanstack/react-query": "^5.59.0",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.11",
    "expo-linking": "~57.0.6",
    "expo-localization": "~57.0.1",
    "expo-notifications": "^57.0.11",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "^19.2.18",
    "eslint": "^9.9.0",
    "globals": "^15.15.0",
    "localtunnel": "^2.0.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.0.5"
  }
}
